{
  "config_name": "嘉宾模式统计配置",
  "version": "1.0.0",
  "description": "配置嘉宾模式下的各种统计参数",
  
  "基础统计": {
    "初始心动指数": 30.0,
    "最大心动指数": 100.0,
    "初始好感度": 20.0,
    "最大好感度": 100.0
  },
  
  "衰减配置": {
    "专注度衰减率": 0.1,
    "好感度衰减率": 0.05,
    "社交活跃度衰减率": 0.02,
    "衰减检查间隔": 60.0
  },
  
  "增长配置": {
    "对话好感度增益": 2.0,
    "约会好感度增益": 10.0,
    "心动好感度增益": 5.0,
    "社交倍数": 1.0
  },
  
  "特殊配置": {
    "启用心动加成": true,
    "心动加成倍数": 1.5,
    "关键心动阈值": 5,
    "互动范围": 10.0
  },
  
  "显示配置": {
    "更新间隔": 0.5,
    "启用实时更新": true,
    "显示小数位数": 0,
    "显示百分比": true
  },
  
  "统计指标": {
    "心动指数": {
      "权重_好感度": 0.4,
      "权重_对话": 0.2,
      "权重_约会": 0.2,
      "权重_心动": 0.2,
      "权重_专注度": 0.0,
      "权重_社交": 0.0
    },
    "专注度": {
      "计算方式": "focus_interactions / total_interactions",
      "衰减时间": 300
    },
    "社交活跃度": {
      "计算方式": "average_interactions_with_others",
      "权重_对话": 1.0,
      "权重_约会": 2.0
    }
  },
  
  "记录配置": {
    "记录对话": true,
    "记录约会": true,
    "记录心动": true,
    "记录好感度历史": true,
    "最大历史记录数": 100
  },
  
  "UI配置": {
    "显示标题": "📊 数据统计面板（嘉宾模式）",
    "显示游戏进度": true,
    "显示感情线": true,
    "显示好感度列表": true,
    "显示统计指标": true,
    "显示图表": true
  }
}
